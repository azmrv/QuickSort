{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quicksort",
  "version": "0.2.5",
  "identifier": "com.azmrv.quicksort",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "quicksort",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "azmrv",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "../resources/quicksort.ico"
    ],
    "resources": {
      "../resources/quicksort.ico": "resources/quicksort.ico",
      "../target/release/context_menu_dll.dll": "context_menu_dll.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "../resources/quicksort.ico",
        "languages": ["Russian", "English"],
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/hooks.nsh",
        "customLanguageFiles": {
          "Russian": "nsis/Russian.nsh",
          "English": "nsis/English.nsh"
        }
      },
      "wix": null
    }
  }
}

