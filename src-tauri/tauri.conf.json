{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quicksort",
  "version": "0.2.0",
  "identifier": "promatheus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "quicksort",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/32x32.png",
      "../resources/128x128.png",
      "../resources/128x128@2x.png",
      "icons/icon.icns",
      "../resources/quicksort.ico"
    ]
  }
}

